APP_ENV=local
APP_URL=http://localhost/cozycafe

# XAMPP local defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cozycafe
DB_USER=root
DB_PASS=

# Gmail SMTP (leave empty until configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CozyCafe

# Local Docker Compose credentials; change before using a non-local environment.
MYSQL_ROOT_PASSWORD=change-local-root-password
MYSQL_APP_USER=cozycafe_app
MYSQL_APP_PASSWORD=change-local-app-password

# Optional HTTP trigger for cron/cleanup_expired.php; use at least 32 random characters.
CRON_SECRET=

# Optional APP_URL override for Docker Compose (defaults to http://localhost:8080).
DOCKER_APP_URL=http://localhost:8080
